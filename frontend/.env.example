# Same-origin versioned business API prefix bundled by Vite.
VITE_API_BASE_URL=/api/v1
# Development-only backend target; never bundled into client source.
DEV_API_PROXY_TARGET=http://127.0.0.1:8000
# Vite development bind interface and port.
DEV_HOST=0.0.0.0
DEV_PORT=5173
# E2E browser origin and API probe, consumed only by Playwright config.
E2E_BASE_URL=http://127.0.0.1:5173
E2E_API_URL=http://127.0.0.1:8000
# E2E Python executable; parent may override to its prepared virtualenv.
E2E_PYTHON=python
