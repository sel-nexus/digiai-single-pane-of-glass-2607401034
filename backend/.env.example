# Real file-backed prototype SQLite path, relative to backend cwd.
DATABASE_PATH=data/digiai.db
# Insert synthetic sample records on first startup.
SEED_ON_STARTUP=true
# Comma-separated development browser origins; optional for same-origin deployment.
CORS_ORIGINS=http://localhost:5173
# API listen interface and port.
BIND_HOST=0.0.0.0
BIND_PORT=8000
# Standard Python logging level.
LOG_LEVEL=INFO
# Approved prototype ingestion limits reserved for the ingestion slice.
UPLOAD_MAX_BYTES=5242880
UPLOAD_MAX_ROWS=5000
UPLOAD_MAX_COLUMNS=100
XLSX_MAX_EXPANDED_BYTES=52428800
# Bounded query defaults.
QUERY_DEFAULT_LIMIT=50
QUERY_MAX_LIMIT=100
